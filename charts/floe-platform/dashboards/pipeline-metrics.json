{
  "uid": "floe-pipeline-metrics",
  "title": "Floe Alpha Runtime Metrics",
  "tags": ["floe", "alpha", "runtime", "metrics"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "{{ .GrafanaRefreshInterval }}",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Asset Materializations by Product",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (floe_product_name, floe_stage, floe_status) (increase(floe_asset_materializations_total[15m]))",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "{{ .PrometheusDatasourceUid }}"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Customer 360 Successful Materializations",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 8},
      "targets": [
        {
          "expr": "sum(increase(floe_asset_materializations_total{floe_product_name=\"customer-360\",floe_status=\"success\"}[1h]))",
          "legendFormat": "customer-360",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "{{ .PrometheusDatasourceUid }}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Asset Failures",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
      "targets": [
        {
          "expr": "sum(increase(floe_asset_failures_total[1h]))",
          "legendFormat": "failures",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "{{ .PrometheusDatasourceUid }}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Materializations by Plugin",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (floe_plugin_type, floe_plugin_name, floe_status) (increase(floe_asset_materializations_total[15m]))",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "{{ .PrometheusDatasourceUid }}"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Customer 360 Runtime Stages",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (floe_stage, floe_plugin_name) (increase(floe_asset_materializations_total{floe_product_name=\"customer-360\",floe_status=\"success\"}[15m]))",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "{{ .PrometheusDatasourceUid }}"
      }
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Materialization Status Distribution",
      "gridPos": {"x": 0, "y": 16, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "sum by (floe_status) (increase(floe_asset_materializations_total[1h]))",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "{{ .PrometheusDatasourceUid }}"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "OTel Collector Scrape",
      "gridPos": {"x": 8, "y": 16, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "up{job=\"floe-otel-collector\"}",
          "legendFormat": "otel collector",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "{{ .PrometheusDatasourceUid }}"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Prometheus Scrape",
      "gridPos": {"x": 16, "y": 16, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "up{job=\"floe-prometheus\"}",
          "legendFormat": "prometheus",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "{{ .PrometheusDatasourceUid }}"
      }
    }
  ]
}
