# Docker build context exclusions
# Reduces context size for faster builds

# Version control
.git/

# Python environments and caches
.venv/
__pycache__/
**/__pycache__/
*.pyc
.mypy_cache/
**/.mypy_cache/
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/

# IDE and editor
.vscode/
.idea/

# Project tooling (not needed in images)
.specwright/
.claude/

# Local IaC state and provider caches (never needed in Docker build contexts)
**/.terraform/
**/*.tfstate*
**/tfplan
**/terraform.tfvars

# Node (if any)
node_modules/
